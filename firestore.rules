rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserCloudProfile(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string &&
             data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.email is string &&
             data.email.size() <= 160 &&
             data.totalXp is int && data.totalXp >= 0 && data.totalXp <= 10000000 &&
             data.currentStreakDays is int && data.currentStreakDays >= 0 && data.currentStreakDays <= 10000 &&
             data.longestStreakDays is int && data.longestStreakDays >= 0 && data.longestStreakDays <= 10000 &&
             data.totalCommandsExecuted is int && data.totalCommandsExecuted >= 0 && data.totalCommandsExecuted <= 1000000 &&
             data.selectedInitialLevel is int && data.selectedInitialLevel >= 1 && data.selectedInitialLevel <= 8 &&
             data.preferredTheme is string && (data.preferredTheme == 'DARK' || data.preferredTheme == 'LIGHT') &&
             data.preferredLanguage is string && (data.preferredLanguage == 'ES' || data.preferredLanguage == 'EN') &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll([
                         'userId',
                         'displayName',
                         'email',
                         'totalXp',
                         'currentStreakDays',
                         'longestStreakDays',
                         'totalCommandsExecuted',
                         'selectedInitialLevel',
                         'preferredTheme',
                         'preferredLanguage',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId',
                         'displayName',
                         'email',
                         'totalXp',
                         'currentStreakDays',
                         'longestStreakDays',
                         'totalCommandsExecuted',
                         'selectedInitialLevel',
                         'preferredTheme',
                         'preferredLanguage',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       isValidUserCloudProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserCloudProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName',
                         'email',
                         'totalXp',
                         'currentStreakDays',
                         'longestStreakDays',
                         'totalCommandsExecuted',
                         'selectedInitialLevel',
                         'preferredTheme',
                         'preferredLanguage',
                         'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }
  }
}
